{
  "name": "sh-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"node scripts/dev-server.js\" \"vite --config vite.config.js\"",
    "dev:api": "node scripts/dev-server.js",
    "dev:frontend": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js && node scripts/copy-static.js",
    "preview": "vite preview --config vite.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .js"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "hls.js": "^1.7.3"
  }
}
